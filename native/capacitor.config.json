{
  "appId": "com.gymflow.app",
  "appName": "GymFlow",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#121212",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
